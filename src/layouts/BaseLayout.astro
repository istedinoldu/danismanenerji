---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${SITE.name} | Güneş Enerjisi Sistemleri ve Elektrik Çözümleri`,
  description = SITE.description,
  canonical = new URL(Astro.url.pathname, SITE.url).href,
  ogImage,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  extraSchema,
} = Astro.props;

const resolvedOgImage = ogImage
  ? new URL(ogImage, SITE.url).href
  : new URL('/og-default.jpg', SITE.url).href;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#organization`,
  name: SITE.legalName,
  alternateName: SITE.name,
  url: SITE.url,
  telephone: SITE.phoneRaw,
  email: SITE.email,
  areaServed: [
    { '@type': 'City', name: 'Ankara' },
    { '@type': 'Country', name: 'Türkiye' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.district,
    addressRegion: SITE.address.city,
    addressCountry: SITE.address.country,
  },
};

const schemas = extraSchema
  ? [localBusinessSchema, ...(Array.isArray(extraSchema) ? extraSchema : [extraSchema])]
  : [localBusinessSchema];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {schemas.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#0e342c] selection:bg-brand-lime selection:text-[#0e342c] font-sans antialiased">
    <!-- Üst Kurumsal Header -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-xs border-b border-slate-200 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-20">
          <!-- Logo -->
          <a href="/" class="flex items-center group py-2 shrink-0">
            <img
              src="/images/brand/logo.webp"
              alt={SITE.name}
              width="410"
              height="94"
              class="h-10 sm:h-12 w-auto object-contain"
            />
          </a>

          <!-- Masaüstü Navigasyon Menüsü -->
          <nav class="hidden md:flex items-center gap-8" aria-label="Ana Menü">
            {SITE.nav.map((link) => {
              const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class:list={[
                    'text-sm font-semibold transition-colors',
                    isActive ? 'text-brand-lime' : 'text-slate-600 hover:text-slate-900',
                  ]}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>

          <!-- Masaüstü Hızlı İletişim Butonları -->
          <div class="hidden sm:flex items-center gap-3">
            <a
              href={SITE.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xs transition-colors"
            >
              WhatsApp
            </a>
            <a
              href="/iletisim/"
              class="px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-white bg-[#0e342c] hover:bg-[#154035] rounded-xs transition-colors"
            >
              Teklif Alın
            </a>
          </div>

          <!-- Mobil Menü Butonu (md altında görünür) -->
          <button
            type="button"
            id="mobile-menu-toggle"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Menüyü Aç veya Kapat"
            class="md:hidden inline-flex items-center justify-center p-2.5 rounded-xs text-[#0e342c] hover:bg-slate-100 focus:outline-none transition-colors cursor-pointer"
          >
            <!-- Hamburger İkonu -->
            <svg
              id="menu-icon-open"
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Kapatma (X) İkonu -->
            <svg
              id="menu-icon-close"
              class="w-6 h-6 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobil Açılır Menü Paneli -->
      <div
        id="mobile-menu"
        class="md:hidden hidden border-t border-slate-200 bg-white shadow-lg"
      >
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 space-y-4">
          <nav class="flex flex-col space-y-1" aria-label="Mobil Menü">
            {SITE.nav.map((link) => {
              const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class:list={[
                    'px-3 py-2.5 rounded-xs text-base font-semibold transition-colors',
                    isActive
                      ? 'bg-[#0e342c] text-[#a3e635]'
                      : 'text-slate-700 hover:bg-slate-50 hover:text-[#0e342c]',
                  ]}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>

          <div class="pt-3 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a
              href={SITE.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full text-center px-4 py-3 text-xs font-semibold uppercase tracking-wider text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xs transition-colors"
            >
              WhatsApp
            </a>
            <a
              href="/iletisim/"
              class="w-full text-center px-5 py-3 text-xs font-semibold uppercase tracking-wider text-white bg-[#0e342c] hover:bg-[#154035] rounded-xs transition-colors"
            >
              Teklif Alın
            </a>
          </div>
        </div>
      </div>
    </header>

    <script>
      const menuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      function setMenuState(isOpen: boolean) {
        if (!menuToggle || !mobileMenu || !iconOpen || !iconClose) return;
        mobileMenu.classList.toggle('hidden', !isOpen);
        iconOpen.classList.toggle('hidden', isOpen);
        iconClose.classList.toggle('hidden', !isOpen);
        menuToggle.setAttribute('aria-expanded', String(isOpen));
      }

      menuToggle?.addEventListener('click', () => {
        const isCurrentlyOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        setMenuState(!isCurrentlyOpen);
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuState(false));
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
          setMenuState(false);
        }
      });
    </script>


    <!-- Ana İçerik -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Alt Bilgi (Footer) -->
    <footer class="text-slate-300 border-t pt-16 pb-12" style="background-color: #0e342c; border-color: #1e5040;">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 text-sm" style="border-bottom: 1px solid #1e5040;">
          <!-- Şirket Özeti -->
          <div class="md:col-span-5 space-y-4">
            <div>
              <a href="/" class="inline-block bg-white p-2.5 rounded-xs shadow-xs">
                <img
                  src="/images/brand/logo.webp"
                  alt={SITE.name}
                  width="410"
                  height="94"
                  class="h-8 w-auto object-contain"
                />
              </a>
            </div>
            <p class="leading-relaxed max-w-sm text-slate-300">
              {SITE.description}
            </p>
          </div>

          <!-- Hızlı Bağlantılar -->
          <div class="md:col-span-3 space-y-3">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white">Kurumsal</h3>
            <ul class="space-y-2">
              {SITE.nav.map((link) => (
                <li>
                  <a href={link.href} class="transition-colors hover:text-brand-lime">
                    {link.label}
                  </a>
                </li>
              ))}
              <li>
                <a href="/gizlilik-ilkesi/" class="transition-colors hover:text-brand-lime">
                  Gizlilik İlkesi
                </a>
              </li>
            </ul>
          </div>

          <!-- İletişim Bilgileri -->
          <div class="md:col-span-4 space-y-3">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-white">İletişim</h3>
            <div class="space-y-2 text-slate-300">
              <p>{SITE.address.street}, {SITE.address.district} / {SITE.address.city}</p>
              <p>Telefon: <a href={`tel:${SITE.phoneRaw}`} class="font-medium hover:text-brand-lime">{SITE.phone}</a></p>
              <p>E-posta: <a href={`mailto:${SITE.email}`} class="font-medium hover:text-brand-lime">{SITE.email}</a></p>
              <p>Yetkili E-posta: <a href={`mailto:${SITE.secondaryEmail}`} class="font-medium hover:text-brand-lime">{SITE.secondaryEmail}</a></p>
            </div>
          </div>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
          <p>&copy; {new Date().getFullYear()} {SITE.legalName}. Tüm hakları saklıdır.</p>
          <div class="flex items-center gap-6">
            <a href="/gizlilik-ilkesi/" class="hover:text-slate-200 transition-colors">Gizlilik & KVKK</a>
            <a href="/iletisim/" class="hover:text-slate-200 transition-colors">Bize Ulaşın</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
