---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  topSubtitle?: string;
  ctaLabel?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description,
  href,
  topSubtitle,
  ctaLabel = 'Detayları İncele',
  image,
  imageAlt = title,
} = Astro.props;
---

<article
  class="group bg-white border border-slate-200/80 rounded-lg overflow-hidden flex flex-col shadow-[0_10px_30px_-10px_rgba(14,52,44,0.12)] hover:shadow-[0_18px_38px_-12px_rgba(14,52,44,0.2)] transition-all duration-300"
>
  <!-- Üst Başlık / Sağ Üst Alt Başlık Satırı -->
  <div class="px-5 pt-3.5 pb-2.5 flex items-center justify-end min-h-9 bg-white">
    {topSubtitle && (
      <span class="text-xs font-medium text-slate-500 text-right truncate">
        {topSubtitle}
      </span>
    )}
  </div>

  <!-- Maskeli Görsel Alanı -->
  <a
    href={href}
    class="relative block aspect-[16/10] w-full overflow-hidden bg-[#0e342c]"
    style="clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);"
  >
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex flex-col justify-between p-5 bg-gradient-to-br from-[#0e342c] to-[#164a3e] text-white/80">
        <span class="text-[11px] font-semibold uppercase tracking-widest text-brand-lime self-start">
          Danışman Enerji
        </span>
        <span class="text-xs text-slate-300 font-medium">Teknik Bilgi &amp; Saha Uzmanlığı</span>
      </div>
    )}
  </a>

  <!-- Alt İçerik ve Buton -->
  <div class="px-5 pt-4 pb-6 flex-1 flex flex-col justify-between bg-white">
    <div class="space-y-2.5">
      <h3 class="text-lg font-bold text-[#0e342c] group-hover:text-[#164a3e] transition-colors leading-snug">
        <a href={href}>{title}</a>
      </h3>
      <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    <div class="pt-5">
      <a
        href={href}
        class="inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-[#0e342c] bg-white border border-[#1e5040]/40 hover:bg-[#0e342c] hover:text-brand-lime hover:border-[#0e342c] rounded-md transition-colors"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</article>
