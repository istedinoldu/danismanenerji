---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
  eyebrow?: string;
}

const {
  faqs,
  title = 'Sıkça Sorulan Sorular',
  eyebrow = 'Merak Edilenler',
} = Astro.props;
---

{faqs && faqs.length > 0 && (
  <section class="mt-14 pt-10 border-t border-slate-200" aria-labelledby="faq-heading">
    <div class="mb-7 space-y-2">
      <span class="inline-block text-xs font-semibold uppercase tracking-widest text-brand-lime">
        {eyebrow}
      </span>
      <h2 id="faq-heading" class="text-2xl sm:text-[26px] font-bold tracking-tight text-[#0e342c]">
        {title}
      </h2>
    </div>

    <div class="faq-container flex flex-col gap-3.5 w-full">
      {faqs.map((faq, index) => (
        <div class="faq-item border border-slate-200/90 rounded-md overflow-hidden bg-white shadow-2xs transition-colors">
          <button
            type="button"
            class="faq-header flex items-center justify-between gap-4 w-full text-left cursor-pointer bg-gradient-to-r from-[#f4f7f5] to-white hover:from-[#eaf2ed] px-5 py-4 transition-colors"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
          >
            <span class="text-[15px] sm:text-base font-semibold text-[#0e342c] leading-snug">
              {faq.question}
            </span>
            <span class="w-7 h-7 shrink-0 rounded-xs bg-[#0e342c] text-brand-lime flex items-center justify-center">
              <svg
                class="faq-icon transition-transform duration-300 ease-in-out"
                width="16"
                height="16"
                viewBox="0 0 18 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="m4.5 7.2 3.793 3.793a1 1 0 0 0 1.414 0L13.5 7.2"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>

          <div
            id={`faq-answer-${index}`}
            class="faq-answer text-sm sm:text-[15px] text-slate-600 leading-relaxed px-5 overflow-hidden max-h-0 opacity-0 -translate-y-1 transition-all duration-300 ease-in-out"
          >
            <p class="pb-4 pt-3 border-t border-slate-100">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<script>
  function initFaqs() {
    const containers = document.querySelectorAll('.faq-container');

    containers.forEach((container) => {
      const headers = container.querySelectorAll<HTMLButtonElement>('.faq-header');
      const answers = container.querySelectorAll<HTMLElement>('.faq-answer');
      const icons = container.querySelectorAll<HTMLElement>('.faq-icon');

      headers.forEach((header, index) => {
        header.addEventListener('click', () => {
          answers.forEach((el, i) => {
            if (i === index) {
              const isOpen = el.classList.contains('opacity-100');
              header.setAttribute('aria-expanded', String(!isOpen));

              el.classList.toggle('opacity-100', !isOpen);
              el.classList.toggle('max-h-[500px]', !isOpen);
              el.classList.toggle('translate-y-0', !isOpen);

              el.classList.toggle('max-h-0', isOpen);
              el.classList.toggle('opacity-0', isOpen);
              el.classList.toggle('-translate-y-1', isOpen);

              icons[i]?.classList.toggle('rotate-180', !isOpen);
            } else {
              headers[i]?.setAttribute('aria-expanded', 'false');
              el.classList.remove('opacity-100', 'max-h-[500px]', 'translate-y-0');
              el.classList.add('max-h-0', 'opacity-0', '-translate-y-1');
              icons[i]?.classList.remove('rotate-180');
            }
          });
        });
      });
    });
  }

  initFaqs();
  document.addEventListener('astro:after-swap', initFaqs);
</script>
