---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
}

const { title, eyebrow, description } = Astro.props;
---

<header class="text-white border-b py-16 sm:py-20" style="background-color: #0e342c; border-color: #1e5040;">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl space-y-3">
      {eyebrow && (
        <span class="inline-block text-xs font-semibold uppercase tracking-widest text-brand-lime">
          {eyebrow}
        </span>
      )}
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
        {title}
      </h1>
      {description && (
        <p class="text-base sm:text-lg leading-relaxed pt-1 text-slate-300">
          {description}
        </p>
      )}
    </div>
  </div>
</header>
