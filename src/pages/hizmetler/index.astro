---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`Hizmetlerimiz | ${SITE.name}`}>
  <PageHeader
    eyebrow="Faaliyet Alanlarımız"
    title="Hizmetlerimiz"
    description="Güneş enerjisi kurulumu, santral verimlilik bakımı ve elektrik altyapı uygulamalarında sunduğumuz çözümler."
  />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 space-y-8">
    {services.map((service, index) => {
      const slug = (service as any).slug || service.id;
      return (
        <article class="border border-slate-200 bg-white p-8 rounded-xs grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-semibold text-brand-lime">0{index + 1}</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                {service.data.heroBadge}
              </span>
            </div>
            <h2 class="text-2xl font-bold text-slate-900">{service.data.title}</h2>
            <p class="text-slate-600 leading-relaxed">{service.data.shortDescription}</p>
          </div>
          <div class="lg:col-span-4 lg:text-right">
            <a
              href={`/hizmetler/${slug}/`}
              class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-white rounded-xs transition-colors"
              style="background-color: #0e342c;"
              onmouseover="this.style.backgroundColor='#154035'"
              onmouseout="this.style.backgroundColor='#0e342c'"
            >
              Detayları İncele &rarr;
            </a>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
