---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={`İletişim | ${SITE.name}`}>
  <PageHeader
    eyebrow="İletişim"
    title="Bizimle İletişime Geçin"
    description="GES kurulumu, panel temizliği ve elektrik projeleriniz için keşif, teklif veya teknik bilgi taleplerinizi iletebilirsiniz."
  />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Sol: Doğrudan İletişim Kanalları -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-50 border border-slate-200 p-7 rounded-xs space-y-5 text-sm">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#0e342c]">Merkez Ofis</span>
            <h2 class="text-lg font-bold text-slate-900 mt-1">{SITE.legalName}</h2>
          </div>

          <div class="space-y-4 border-t border-slate-200 pt-4">
            <div>
              <div class="text-slate-500">Adres</div>
              <div class="font-medium text-slate-900 mt-0.5">
                {SITE.address.street}<br />
                {SITE.address.district} / {SITE.address.city}
              </div>
            </div>
            <div>
              <div class="text-slate-500">Telefon</div>
              <a href={`tel:${SITE.phoneRaw}`} class="font-semibold text-slate-900 hover:text-[#0e342c] mt-0.5 inline-block">
                {SITE.phone}
              </a>
            </div>
            <div>
              <div class="text-slate-500">E-posta</div>
              <a href={`mailto:${SITE.email}`} class="font-medium text-slate-900 hover:text-[#0e342c] mt-0.5 block">
                {SITE.email}
              </a>
              {SITE.secondaryEmail && (
                <a href={`mailto:${SITE.secondaryEmail}`} class="font-medium text-slate-600 hover:text-[#0e342c] mt-0.5 text-xs block">
                  {SITE.secondaryEmail}
                </a>
              )}
            </div>
          </div>

          <div class="pt-2">
            <a
              href={SITE.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center px-5 py-3 text-sm font-semibold text-white bg-[#0e342c] hover:bg-[#154035] rounded-xs transition-colors"
            >
              WhatsApp Üzerinden Mesaj Gönder
            </a>
          </div>
        </div>
      </div>

      <!-- Sağ: Sade Teklif / İletişim Formu (Lokal test için hazır) -->
      <div class="lg:col-span-7 border border-slate-200 bg-white p-8 rounded-xs">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Talep Formu</h2>
        <p class="text-sm text-slate-600 mb-6">
          Bilgilerinizi bırakın, mühendislik ekibimiz en kısa sürede dönüş yapsın.
        </p>

        <form id="contact-form" action="https://formspree.io/f/xvkawzjy" method="POST" class="space-y-5">
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Ad Soyad / Firma</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-xs focus:outline-none focus:border-slate-900"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-slate-700 mb-1.5">Telefon Numarası</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-xs focus:outline-none focus:border-slate-900"
      />
    </div>
  </div>

  <div>
    <label for="service" class="block text-sm font-medium text-slate-700 mb-1.5">İlgilendiğiniz Hizmet</label>
    <select
      id="service"
      name="service"
      class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-xs bg-white focus:outline-none focus:border-slate-900"
    >
      <option value="GES Kurulumu">GES Kurulumu</option>
      <option value="GES Panel Temizliği">GES Panel Temizliği</option>
      <option value="Elektrik İşleri">Elektrik İşleri</option>
      <option value="Diğer / Genel Bilgi">Diğer / Genel Bilgi</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-slate-700 mb-1.5">Proje / Talep Detayı</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      required
      class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-xs focus:outline-none focus:border-slate-900"
    ></textarea>
  </div>

  <div id="form-status" class="hidden p-4 rounded-xs text-sm font-medium"></div>

  <button
    type="submit"
    id="submit-btn"
    class="px-6 py-3 text-sm font-semibold text-white bg-[#0e342c] hover:bg-[#154035] disabled:opacity-60 rounded-xs transition-colors cursor-pointer"
  >
    Talebi Gönder
  </button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !statusEl || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Gönderiliyor...';
    statusEl.classList.add('hidden');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        statusEl.textContent = 'Talebiniz başarıyla alındı. Mühendislik ekibimiz en kısa sürede dönüş yapacaktır.';
        statusEl.className = 'p-4 rounded-xs text-sm font-medium bg-[#0e342c] text-[#a3e635] border border-[#a3e635]/40';
        form.reset();
      } else {
        throw new Error('Gönderim hatası');
      }
    } catch {
      statusEl.textContent = 'Gönderim sırasında bir sorun oluştu. Lütfen tekrar deneyin veya WhatsApp hattımızdan ulaşın.';
      statusEl.className = 'p-4 rounded-xs text-sm font-medium bg-red-50 text-red-800 border border-red-200';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Talebi Gönder';
    }
  });
</script>
      </div>
    </div>
  </section>
</BaseLayout>
