---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`Sayfa Bulunamadı (404) | ${SITE.name}`}
  description="Aradığınız sayfa bulunamadı veya taşınmış olabilir."
  noindex={true}
>
  <section class="bg-slate-50 border-b border-slate-200 py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl space-y-6">
        <span class="inline-block text-xs font-mono font-semibold uppercase tracking-widest text-[#0e342c]">
          Hata Kodu — 404
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
          Aradığınız sayfa bulunamadı.
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Bağlantı güncellenmiş, sayfa kaldırılmış veya adresi hatalı yazılmış olabilir. Aşağıdaki bağlantılardan sitenin ana bölümlerine geçiş yapabilirsiniz.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="/"
            class="px-6 py-3.5 text-sm font-semibold text-white bg-[#0e342c] hover:bg-[#154035] rounded-xs transition-colors"
          >
            Anasayfaya Dön
          </a>
          <a
            href="/hizmetler/"
            class="px-6 py-3.5 text-sm font-semibold text-slate-900 bg-white border border-slate-300 hover:border-[#0e342c] rounded-xs transition-colors"
          >
            Hizmetlerimizi İncele
          </a>
          <a
            href="/iletisim/"
            class="px-6 py-3.5 text-sm font-semibold text-slate-700 hover:text-slate-900 px-2 py-3 transition-colors"
          >
            İletişim &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alt Kısım: Hızlı Yönlendirme Kutuları -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a
        href="/hakkimizda/"
        class="border border-slate-200 bg-white p-6 rounded-xs hover:border-slate-400 transition-colors block"
      >
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0e342c]">Kurumsal</span>
        <h2 class="text-lg font-bold text-slate-900 mt-1.5">Hakkımızda</h2>
        <p class="text-sm text-slate-600 mt-1">Danışman Enerji Ltd. Şti. vizyonu, misyonu ve faaliyet alanları.</p>
      </a>

      <a
        href="/blog/"
        class="border border-slate-200 bg-white p-6 rounded-xs hover:border-slate-400 transition-colors block"
      >
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0e342c]">Bilgi Merkezi</span>
        <h2 class="text-lg font-bold text-slate-900 mt-1.5">Blog & Teknik Yazılar</h2>
        <p class="text-sm text-slate-600 mt-1">GES panel temizliği, verimlilik ve bakım üzerine içerikler.</p>
      </a>

      <a
        href="/iletisim/"
        class="border border-slate-200 bg-white p-6 rounded-xs hover:border-slate-400 transition-colors block"
      >
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0e342c]">Destek</span>
        <h2 class="text-lg font-bold text-slate-900 mt-1.5">Keşif & İletişim</h2>
        <p class="text-sm text-slate-600 mt-1">Telefon, WhatsApp veya iletişim formu üzerinden bize ulaşın.</p>
      </a>
    </div>
  </section>
</BaseLayout>